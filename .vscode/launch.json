{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linting",
            "type": "python",
            "request": "launch",
            "module": "flake8",
            "args": [
                "--exclude",
                "venv/"
            ]
        },
        {
            "name": "Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
