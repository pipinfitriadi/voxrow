{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linter Test",
            "type": "python",
            "request": "launch",
            "module": "flake8",
            "args": [
                "--exclude",
                "env/",
                "--ignore",
                "W503"
            ]
        },
        {
            "name": "Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
